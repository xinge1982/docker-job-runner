{
  "work_root": "/jobrunner/jobs",
  "host_work_root": "${HOST_JOBRUNNER_ROOT}/jobs",
  "debug": false,
  "tasks": {
    "feature_road_id": {
      "image": "alpine:3.14",
      "memory": "4g",
      "cpus": "2.0",
      "network": "sign_default",
      "work_dir": "/app",
      "mounts": [
        {
          "source": "${HOST_JOBRUNNER_ROOT}/programs",
          "target": "/app/programs",
          "read_only": true
        },
        {
          "source": "${HOST_JOBRUNNER_ROOT}/networks",
          "target": "/app/networks",
          "read_only": false
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "command": [
        "/app/programs/map-tool",
        "feature-road-id"
      ],
      "mode": "direct",
      "schema_argument": "--jobrunner-schema"
    }
  }
}

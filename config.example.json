{
  "work_root": "./jobs",
  "debug": false,
  "tasks": {
    "tileset_build": {
      "image": "alpine:3.14",
      "memory": "8g",
      "cpus": "4.0",
      "network": "sign_default",
      "work_dir": "/app",
      "mounts": [
        {
          "source": "/srv/jobrunner/programs",
          "target": "/app/programs",
          "read_only": true
        },
        {
          "source": "/srv/jobrunner/networks",
          "target": "/app/networks",
          "read_only": false
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "command": [
        "/app/programs/tileset-lod-tool",
        "feature-tileset-build"
      ],
      "mode": "direct",
      "schema_argument": "--jobrunner-schema"
    },
    "feature_road_id": {
      "image": "alpine:3.14",
      "memory": "4g",
      "cpus": "2.0",
      "network": "sign_default",
      "work_dir": "/app",
      "mounts": [
        {
          "source": "/srv/jobrunner/programs",
          "target": "/app/programs",
          "read_only": true
        },
        {
          "source": "/srv/jobrunner/networks",
          "target": "/app/networks",
          "read_only": false
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "command": [
        "/app/programs/map-tool",
        "feature-road-id"
      ],
      "mode": "direct",
      "schema_argument": "--jobrunner-schema"
    },
    "missing_poles": {
      "image": "python:3.11-alpine",
      "memory": "2g",
      "cpus": "1.0",
      "network": "sign_default",
      "work_dir": "/app",
      "mounts": [
        {
          "source": "/srv/jobrunner/programs",
          "target": "/app/programs",
          "read_only": true
        },
        {
          "source": "/srv/jobrunner/networks",
          "target": "/app/networks",
          "read_only": false
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      },
      "command": [
        "python",
        "/app/programs/scripts/missing_poles.py",
        "--input=/job/input.json",
        "--output=/job/output/result.json"
      ],
      "mode": "direct",
      "schema_argument": "--jobrunner-schema"
    }
  }
}
